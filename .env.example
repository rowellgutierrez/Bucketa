# Bucketa environment variables — NAMES ONLY. Never put a real secret in this file.
# Copy to .env for local use only:  Copy-Item .env.example .env
# .env is excluded from Git by .gitignore (.env, .env.*, except !.env.example).
#
# Judge setup (primary): set MODEL_API_KEY to your own Meta Model API
# key and ENABLE_LIVE_META=1 below, then start the server and frontend.
# No other credential is needed in the app — there is no user-entered
# temporary token. Without a key, live Meta AI stays disabled and Bucky
# answers with a clearly labelled deterministic fallback (no paid calls).

# Server-only key for the Meta Model API (backend only — never expose in
# the browser; never rename this to a VITE_* variable, which would ship
# it to every browser). Read only inside the gated live path; /api/health
# reports only whether it is configured, never its value.
# Leave empty to keep live mode impossible.
MODEL_API_KEY=

# Live Meta API master switch. Must be exactly "1" to arm live mode;
# any other value (including empty) keeps live calls disabled. Arming
# also requires MODEL_API_KEY above. The server binds 127.0.0.1 only
# and rejects non-loopback browser origins before any paid call.
# Bucketa imposes no per-session live request cap (no automatic
# retries); your own Meta account limits, credits, and rate limits
# apply. Live requests may incur Meta charges on your own account.
ENABLE_LIVE_META=

# Port for the local Node.js backend (binds 127.0.0.1 only).
# The Vite dev server proxies /api to this port (default 8787);
# if you change it here, also change vite.config.ts to match.
PORT=8787
