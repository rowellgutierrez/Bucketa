# Bucketa environment variables — names only. Never put real secrets in this file.
# Copy to .env for local use. .env is excluded from Git.

# Server-only key for the Meta Model API (backend only — never expose in the browser).
# Not required in M1A, which runs fully offline with the mock extractor.
MODEL_API_KEY=

# Live Meta API calls (M1B). Live requests also require MODEL_API_KEY and
# a matching per-request x-bucketa-live-test header. Leave empty to keep
# live mode disabled.
ENABLE_LIVE_META=

# Server-only token that a live test request must present in the
# x-bucketa-live-test header. Set a random local value only when running
# an approved live test session. Never commit a real value.
LIVE_TEST_TOKEN=

# Port for the local Node.js backend
PORT=
