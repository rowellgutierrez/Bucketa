# Bucketa environment variables — NAMES ONLY. Never put a real secret in this file.
# Copy to .env for local use only:  Copy-Item .env.example .env
# .env is excluded from Git by .gitignore (.env, .env.*, except !.env.example).
#
# No key at all is required for the default demo: mock extraction and
# deterministic Bucky run fully offline and make no paid API calls.

# Server-only key for the Meta Model API (backend only — never expose in
# the browser; never rename this to a VITE_* variable, which would ship
# it to every browser). Read only inside the gated live path; /api/health
# reports only whether it is configured, never its value.
# Leave empty to keep live mode impossible.
MODEL_API_KEY=

# Live Meta API master switch. Must be exactly "1" to arm live mode;
# any other value (including empty) keeps live calls disabled. Arming
# still requires MODEL_API_KEY above AND the per-request token below,
# and is capped at 3 live requests per server session (no retries).
# Live requests may incur Meta charges on your own account and live
# compatibility is NOT yet verified — see README "Live-test blockers".
ENABLE_LIVE_META=

# Server-only token that a live test request must present in the
# x-bucketa-live-test header. This is NOT your Meta API key — it only
# proves a human approved a live attempt against this local server.
# Set a random local value only for an approved live test session, e.g.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Type the same value into the app only at runtime when prompted; it is
# never stored in the browser. Never commit a real value.
LIVE_TEST_TOKEN=

# Port for the local Node.js backend (binds 127.0.0.1 only).
# The Vite dev server proxies /api to this port (default 8787);
# if you change it here, also change vite.config.ts to match.
PORT=8787
